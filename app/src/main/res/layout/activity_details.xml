<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPoster"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_movie"
                android:background="@color/panel" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="14dp"
                android:textColor="@color/tx"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:textColor="@color/gold" />

            <Button
                android:id="@+id/btnWatch"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_margin="16dp"
                android:text="@string/det_watch"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/accent" />

            <TextView
                android:id="@+id/tvPlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="8dp">

                <TextView android:id="@+id/tabTrailer" style="@style/DetTab" android:text="@string/det_trailer" />
                <TextView android:id="@+id/tabCast" style="@style/DetTab" android:text="@string/det_cast" />
                <TextView android:id="@+id/tabMedia" style="@style/DetTab" android:text="@string/det_media" />
                <TextView android:id="@+id/tabDetails" style="@style/DetTab" android:text="@string/det_details" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:padding="16dp"
                android:textColor="@color/tx"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="‹"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#99000000" />
</FrameLayout>
