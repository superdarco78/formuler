<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strumienie IPTV od dostawcow czesto ida po HTTP (przekierowanie z serwera), wiec zwykly ruch jest dopuszczony.
          -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ok-ok.uk</domain>
    </domain-config>
</network-security-config>
