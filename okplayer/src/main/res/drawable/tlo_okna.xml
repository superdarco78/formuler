<?xml version="1.0" encoding="utf-8"?>
<!-- Okna dialogowe: ciemne szklo z rozowo-fioletowa obwodka (jak grafika z Canvy). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <gradient android:angle="270" android:startColor="#1E1424" android:endColor="#0E0E14" />
        <stroke android:width="1dp" android:color="#66B52AD6" />
    </shape>
</inset>
