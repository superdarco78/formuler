<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tlo">#050507</color>
    <color name="ikona_tlo">#0B1020</color>
    <color name="akcent">#FF3D5A</color>
    <color name="fiolet">#B52AD6</color>
    <!-- Kolorystyka z grafiki Canvy: czern kinowa, roz i fiolet w calej aplikacji (okna, przelaczniki, paski, kursor). -->
    <style name="Motyw" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tlo</item>
        <item name="android:statusBarColor">@color/tlo</item>
        <item name="android:navigationBarColor">@color/tlo</item>
        <item name="colorPrimary">@color/akcent</item>
        <item name="colorPrimaryDark">@color/tlo</item>
        <item name="colorAccent">@color/akcent</item>
        <item name="colorControlActivated">@color/akcent</item>
        <item name="colorControlHighlight">#33FF3D5A</item>
        <item name="android:textColorHighlight">#66B52AD6</item>
        <item name="alertDialogTheme">@style/MotywOkno</item>
    </style>
    <style name="MotywOkno" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/tlo_okna</item>
        <item name="colorAccent">@color/akcent</item>
        <item name="colorControlActivated">@color/akcent</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#BDBDBD</item>
        <item name="buttonBarPositiveButtonStyle">@style/PrzyciskOkna</item>
        <item name="buttonBarNegativeButtonStyle">@style/PrzyciskOknaSzary</item>
        <item name="buttonBarNeutralButtonStyle">@style/PrzyciskOkna</item>
    </style>
    <style name="PrzyciskOkna" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/akcent</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PrzyciskOknaSzary" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#9A9AA6</item>
    </style>
    <style name="Motyw.Odtwarzacz">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
